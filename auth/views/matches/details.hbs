<h1 class="page-title">Match Details</h1>

<div class="section">
  <div class="card-header" style="display: flex; justify-content: space-between; align-items: center;">
    <h3>
      {{match.user_name}} vs. {{match.opponent_name}}
    </h3>
    <a href="javascript:history.back()" class="form-button">Back</a>
  </div>
  
  <div style="display: flex; justify-content: center; align-items: center; margin: 30px 0; text-align: center;">
    <div style="flex: 1;">
      <h3>{{match.user_name}}</h3>
      <div style="font-size: 3rem; font-weight: bold; margin: 10px 0;">{{match.user_score}}</div>
    </div>
    
    <div style="margin: 0 20px; font-size: 2rem; color: #777;">vs.</div>
    
    <div style="flex: 1;">
      <h3>{{match.opponent_name}}</h3>
      <div style="font-size: 3rem; font-weight: bold; margin: 10px 0;">{{match.opponent_score}}</div>
    </div>
  </div>
  
  <div style="background-color: #f5f5f5; padding: 15px; border-radius: 5px; margin-top: 20px;">
    <div style="margin-bottom: 10px;">
      <strong>Date:</strong> {{match.date}}
    </div>
    
    {{#if match.body}}
      <div style="margin-top: 20px;">
        <strong>Match Notes:</strong>
        <p style="margin-top: 10px;">{{match.body}}</p>
      </div>
    {{/if}}
  </div>
  
  <div style="display: flex; justify-content: space-around; margin-top: 30px;">
    <a href="/users/{{match.user_id}}" class="form-button">View {{match.user_name}}'s Profile</a>
    <a href="/users/{{match.opponent}}" class="form-button">View {{match.opponent_name}}'s Profile</a>
  </div>
</div>
