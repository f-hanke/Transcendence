<h1 class="page-title">Blocked Users</h1>

<div class="section">
  <div class="card-header" style="display: flex; justify-content: space-between; align-items: center;">
    <h3>Blocked Users</h3>
    <a href="/friends" class="form-button">Back to Friends</a>
  </div>
  
  {{#if blockedUsers.length}}
    <div class="user-list">
      {{#each blockedUsers}}
        <div class="card user-card">
          <img src="{{this.image}}" alt="{{this.display_name}}" class="user-avatar">
          <h3 class="user-name">{{this.display_name}}</h3>
          <div class="user-actions">
            <form action="/friends/unblock" method="POST">
              <input type="hidden" name="user_id" value="{{this.id}}">
              <button type="submit" class="form-button">Unblock</button>
            </form>
          </div>
        </div>
      {{/each}}
    </div>
  {{else}}
    <div style="text-align: center; padding: 30px;">
      <p>You haven't blocked any users.</p>
    </div>
  {{/if}}
</div>
