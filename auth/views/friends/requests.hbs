<h1 class="page-title">Friend Requests</h1>

<div class="section">
  <h3 class="section-title">Pending Requests</h3>
  
  {{#if pendingRequests.length}}
    <div style="margin-bottom: 30px;">
      {{#each pendingRequests}}
        <div class="friend-request">
          <img src="{{this.image}}" alt="{{this.display_name}}" class="friend-request-avatar">
          <div class="friend-request-info">
            <h4>{{this.display_name}}</h4>
            <p>Wants to be your friend</p>
          </div>
          <div class="friend-request-actions">
            <form action="/friends/accept" method="POST" style="display: inline;">
              <input type="hidden" name="request_id" value="{{this.id}}">
              <button type="submit" class="form-button" style="background-color: #27ae60;">Accept</button>
            </form>
            <form action="/friends/reject" method="POST" style="display: inline;">
              <input type="hidden" name="request_id" value="{{this.id}}">
              <button type="submit" class="form-button" style="background-color: #e74c3c;">Reject</button>
            </form>
          </div>
        </div>
      {{/each}}
    </div>
  {{else}}
    <p>You don't have any pending friend requests.</p>
  {{/if}}
</div>

<div class="section">
  <h3 class="section-title">Sent Requests</h3>
  
  {{#if sentRequests.length}}
    <div>
      {{#each sentRequests}}
        <div class="friend-request">
          <img src="{{this.image}}" alt="{{this.display_name}}" class="friend-request-avatar">
          <div class="friend-request-info">
            <h4>{{this.display_name}}</h4>
            <p>
              Status: 
              {{#if (eq this.status 0)}}
                <span style="color: #f39c12;">Pending</span>
              {{else if (eq this.status 1)}}
                <span style="color: #27ae60;">Accepted</span>
              {{else}}
                <span style="color: #e74c3c;">Rejected</span>
              {{/if}}
            </p>
          </div>
          <div class="friend-request-actions">
            <a href="/users/{{this.responder}}" class="form-button">View Profile</a>
          </div>
        </div>
      {{/each}}
    </div>
  {{else}}
    <p>You haven't sent any friend requests.</p>
  {{/if}}
</div>

<div style="text-align: center; margin-top: 20px;">
  <a href="/friends" class="form-button">Back to Friends</a>
  <a href="/users" class="form-button" style="margin-left: 10px;">Find Users</a>
</div>
