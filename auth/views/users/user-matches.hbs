<h1 class="page-title">{{user.display_name}}'s Match History</h1>

<div class="section">
  <div class="card-header" style="display: flex; justify-content: space-between; align-items: center;">
    <h3>Matches</h3>
    <a href="/users/{{user.id}}" class="form-button">Back to Profile</a>
  </div>

  {{#if matches.length}}
    <table class="match-list">
      <thead>
        <tr>
          <th>Date</th>
          <th>Opponent</th>
          <th>Score</th>
          <th>Result</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        {{#each matches}}
          <tr>
            <td>{{this.date}}</td>
            <td>
              <a href="/users/{{this.opponent}}">{{this.opponent_name}}</a>
            </td>
            <td>{{this.user_score}} - {{this.opponent_score}}</td>
            <td class="match-{{this.result}}">{{uppercase this.result}}</td>
            <td>
              <a href="/matches/{{this.id}}" class="form-button" style="padding: 5px 10px; font-size: 0.8rem;">Details</a>
            </td>
          </tr>
        {{/each}}
      </tbody>
    </table>
    
    {{#if pagination.total}}
      <div class="pagination">
        {{#if (gt pagination.current 1)}}
          <a href="/users/{{user.id}}/matches?page={{subtract pagination.current 1}}" class="pagination-link">&laquo; Previous</a>
        {{else}}
          <span class="pagination-link disabled">&laquo; Previous</span>
        {{/if}}
        
        {{#times pagination.total}}
          <a href="/users/{{user.id}}/matches?page={{this}}" class="pagination-link {{#if (eq this ../pagination.current)}}active{{/if}}">{{this}}</a>
        {{/times}}
        
        {{#if (lt pagination.current pagination.total)}}
          <a href="/users/{{user.id}}/matches?page={{add pagination.current 1}}" class="pagination-link">Next &raquo;</a>
        {{else}}
          <span class="pagination-link disabled">Next &raquo;</span>
        {{/if}}
      </div>
    {{/if}}
  {{else}}
    <div style="text-align: center; padding: 30px;">
      <p>{{user.display_name}} hasn't played any matches yet.</p>
    </div>
  {{/if}}
</div>
