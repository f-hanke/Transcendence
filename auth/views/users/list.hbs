<h1 class="page-title">Users</h1>

<div class="section">
  <div class="card-header" style="display: flex; justify-content: space-between; align-items: center;">
    <h3>All Users</h3>
    <a href="/friends" class="form-button">My Friends</a>
  </div>
  
  {{#if users.length}}
    <div class="user-list">
      {{#each users}}
        <div class="card user-card">
          <img src="{{this.image}}" alt="{{this.display_name}}" class="user-avatar">
          <h3 class="user-name">{{this.display_name}}</h3>
          <span class="user-status {{#if this.online_status}}status-online{{else}}status-offline{{/if}}">
            {{#if this.online_status}}Online{{else}}Offline{{/if}}
          </span>
          <div class="user-actions">
            <a href="/users/{{this.id}}" class="form-button">View Profile</a>
            
            {{#if this.is_friend}}
              <form action="/friends/remove" method="POST" style="display: inline;">
                <input type="hidden" name="friend_id" value="{{this.id}}">
                <button type="submit" class="form-button" style="background-color: #e74c3c;">Remove Friend</button>
              </form>
            {{else if this.is_pending}}
              <button class="form-button" disabled>Request Pending</button>
            {{else if this.is_blocked}}
              <form action="/friends/unblock" method="POST" style="display: inline;">
                <input type="hidden" name="user_id" value="{{this.id}}">
                <button type="submit" class="form-button">Unblock</button>
              </form>
            {{else}}
              <form action="/friends/request" method="POST" style="display: inline;">
                <input type="hidden" name="user_id" value="{{this.id}}">
                <button type="submit" class="form-button">Add Friend</button>
              </form>
            {{/if}}
          </div>
        </div>
      {{/each}}
    </div>
  {{else}}
    <div style="text-align: center; padding: 30px;">
      <p>No other users found.</p>
    </div>
  {{/if}}
</div>
