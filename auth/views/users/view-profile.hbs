<h1 class="page-title">{{user.display_name}}'s Profile</h1>

<div class="profile-container">
  <div class="profile-sidebar">
    <div class="section">
      <img src="{{user.image}}" alt="{{user.display_name}}" class="profile-avatar">
      <h2>{{user.display_name}}</h2>
      <p>Member since: {{user.created_at}}</p>
      
      <div class="profile-stats">
        <div class="profile-stat">
          <div class="profile-stat-value">{{user.stats.wins}}</div>
          <div>Wins</div>
        </div>
        <div class="profile-stat">
          <div class="profile-stat-value">{{user.stats.losses}}</div>
          <div>Losses</div>
        </div>
        <div class="profile-stat">
          <div class="profile-stat-value">{{user.stats.total_games}}</div>
          <div>Games</div>
        </div>
        <div class="profile-stat">
          <div class="profile-stat-value">
            {{#if user.stats.wins}}
              {{round (multiply (divide user.stats.wins user.stats.total_games) 100)}}%
            {{else}}
              0%
            {{/if}}
          </div>
          <div>Win Rate</div>
        </div>
      </div>
      
      <div class="profile-actions">
        {{#if isFriend}}
          <form action="/friends/remove" method="POST">
            <input type="hidden" name="friend_id" value="{{user.id}}">
            <button type="submit" class="form-button">Remove Friend</button>
          </form>
        {{else if isPending}}
          <p>Friend request pending</p>
        {{else}}
          <form action="/friends/request" method="POST">
            <input type="hidden" name="user_id" value="{{user.id}}">
            <button type="submit" class="form-button">Add Friend</button>
          </form>
        {{/if}}
        
        <form action="/matches/new" method="GET">
          <input type="hidden" name="opponent" value="{{user.id}}">
          <button type="submit" class="form-button">Record Match</button>
        </form>
        
        {{#if isBlocked}}
          <form action="/friends/unblock" method="POST">
            <input type="hidden" name="user_id" value="{{user.id}}">
            <button type="submit" class="form-button">Unblock User</button>
          </form>
        {{else}}
          <form action="/friends/block" method="POST">
            <input type="hidden" name="user_id" value="{{user.id}}">
            <button type="submit" class="form-button">Block User</button>
          </form>
        {{/if}}
      </div>
    </div>
  </div>
  
  <div class="profile-content">
    <div class="section">
      <h3 class="section-title">Recent Matches</h3>
      
      {{#if user.stats.total_games}}
        <table class="match-list">
          <thead>
            <tr>
              <th>Date</th>
              <th>Opponent</th>
              <th>Score</th>
              <th>Result</th>
            </tr>
          </thead>
          <tbody>
            {{#each matches}}
              <tr>
                <td>{{this.date}}</td>
                <td>
                  <a href="/users/{{this.opponent}}">{{this.opponent_name}}</a>
                </td>
                <td>{{this.user_score}} - {{this.opponent_score}}</td>
                <td class="match-{{this.result}}">{{uppercase this.result}}</td>
              </tr>
            {{/each}}
          </tbody>
        </table>
        
        <div style="text-align: center; margin-top: 20px;">
          <a href="/users/{{user.id}}/matches" class="form-button">View All Matches</a>
        </div>
      {{else}}
        <p>{{user.display_name}} hasn't played any matches yet.</p>
      {{/if}}
    </div>
  </div>
</div>
