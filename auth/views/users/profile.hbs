<h1 class="page-title">My Profile</h1>

{{#if passwordChanged}}
  <div class="alert alert-success">
    Your password has been successfully changed.
  </div>
{{/if}}

{{#if profileUpdated}}
  <div class="alert alert-success">
    Your profile has been successfully updated.
  </div>
{{/if}}

<div class="profile-container">
  <div class="profile-sidebar">
    <div class="section">
      <img src="{{user.image}}" alt="{{user.display_name}}" class="profile-avatar">
      <h2>{{user.display_name}}</h2>
      <p>Member since: {{user.created_at}}</p>
      
      <div class="profile-stats">
        <div class="profile-stat">
          <div class="profile-stat-value">{{user.stats.wins}}</div>
          <div>Wins</div>
        </div>
        <div class="profile-stat">
          <div class="profile-stat-value">{{user.stats.losses}}</div>
          <div>Losses</div>
        </div>
        <div class="profile-stat">
          <div class="profile-stat-value">{{user.stats.total_games}}</div>
          <div>Games</div>
        </div>
        <div class="profile-stat">
          <div class="profile-stat-value">
            {{#if user.stats.wins}}
              {{round (multiply (divide user.stats.wins user.stats.total_games) 100)}}%
            {{else}}
              0%
            {{/if}}
          </div>
          <div>Win Rate</div>
        </div>
      </div>
      
      <div class="profile-actions">
        <a href="/users/profile/edit" class="form-button">Edit Profile</a>
        <a href="/auth/change-password" class="form-button">Change Password</a>
      </div>
    </div>
  </div>
  
  <div class="profile-content">
    <div class="section">
      <h3 class="section-title">Recent Matches</h3>
      
      {{#if user.stats.total_games}}
        <table class="match-list">
          <thead>
            <tr>
              <th>Date</th>
              <th>Opponent</th>
              <th>Score</th>
              <th>Result</th>
            </tr>
          </thead>
          <tbody>
            {{#each matches}}
              <tr>
                <td>{{this.date}}</td>
                <td>
                  <a href="/users/{{this.opponent}}">{{this.opponent_name}}</a>
                </td>
                <td>{{this.user_score}} - {{this.opponent_score}}</td>
                <td class="match-{{this.result}}">{{uppercase this.result}}</td>
              </tr>
            {{/each}}
          </tbody>
        </table>
        
        <div style="text-align: center; margin-top: 20px;">
          <a href="/users/matches" class="form-button">View All Matches</a>
        </div>
      {{else}}
        <p>You haven't played any matches yet.</p>
        <a href="/matches/new" class="form-button">Record a Match</a>
      {{/if}}
    </div>
    
    <div class="section">
      <h3 class="section-title">Friends</h3>
      
      <div class="user-list">
        {{#each friends}}
          <div class="card user-card">
            <img src="{{this.image}}" alt="{{this.display_name}}" class="user-avatar">
            <h3 class="user-name">{{this.display_name}}</h3>
            <span class="user-status {{#if this.online_status}}status-online{{else}}status-offline{{/if}}">
              {{#if this.online_status}}Online{{else}}Offline{{/if}}
            </span>
            <div class="user-actions">
              <a href="/users/{{this.id}}" class="form-button">View Profile</a>
            </div>
          </div>
        {{else}}
          <p>You haven't added any friends yet.</p>
          <a href="/users" class="form-button">Find Users</a>
        {{/each}}
      </div>
      
      {{#if friends}}
        <div style="text-align: center; margin-top: 20px;">
          <a href="/friends" class="form-button">View All Friends</a>
        </div>
      {{/if}}
    </div>
  </div>
</div>
