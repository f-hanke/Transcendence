<h1 class="page-title">Register</h1>

<div class="section">
  {{#if errors.general}}
    <div class="alert alert-error">
      {{errors.general}}
    </div>
  {{/if}}
  
  <form action="/auth/register" method="POST">
    <div class="form-group">
      <label for="email" class="form-label">Email</label>
      <input type="email" id="email" name="email" class="form-input" value="{{input.email}}" required>
      {{#if errors.email}}
        <div class="form-error">{{errors.email}}</div>
      {{/if}}
    </div>
    
    <div class="form-group">
      <label for="display_name" class="form-label">Display Name</label>
      <input type="text" id="display_name" name="display_name" class="form-input" value="{{input.display_name}}" required>
      {{#if errors.display_name}}
        <div class="form-error">{{errors.display_name}}</div>
      {{/if}}
    </div>
    
    <div class="form-group">
      <label for="password" class="form-label">Password</label>
      <input type="password" id="password" name="password" class="form-input" required>
      {{#if errors.password}}
        <div class="form-error">{{errors.password}}</div>
      {{/if}}
    </div>
    
    <div class="form-group">
      <button type="submit" class="form-button">Register</button>
    </div>
  </form>
  
  <p style="margin-top: 20px; text-align: center;">
    Already have an account? <a href="/auth/login">Login</a>
  </p>
</div>
