<h1 class="page-title">Welcome to Pong User Management</h1>

{{#if session.user}}
  <div class="section">
    <h2 class="section-title">Hello, {{session.user.display_name}}!</h2>
    <p>Welcome to the Pong User Management system. From here, you can manage your profile, view match history, and connect with other players.</p>
    
    <div class="card" style="margin-top: 30px;">
      <div class="card-header">
        <h3>Quick Navigation</h3>
      </div>
      <div class="card-body">
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 15px;">
          <a href="/users/profile" class="form-button" style="text-align: center; text-decoration: none;">
            My Profile
          </a>
          <a href="/users/matches" class="form-button" style="text-align: center; text-decoration: none;">
            Match History
          </a>
          <a href="/matches/new" class="form-button" style="text-align: center; text-decoration: none;">
            Record Match
          </a>
          <a href="/friends" class="form-button" style="text-align: center; text-decoration: none;">
            Friends
          </a>
          <a href="/users" class="form-button" style="text-align: center; text-decoration: none;">
            Browse Users
          </a>
        </div>
      </div>
    </div>
  </div>
{{else}}
  <div class="section">
    <h2 class="section-title">Get Started</h2>
    <p>Welcome to the Pong User Management system. Please login or register to get started.</p>
    
    <div style="display: flex; gap: 20px; margin-top: 30px;">
      <a href="/auth/login" class="form-button" style="text-align: center; text-decoration: none; flex: 1;">
        Login
      </a>
      <a href="/auth/register" class="form-button" style="text-align: center; text-decoration: none; flex: 1;">
        Register
      </a>
    </div>
  </div>
{{/if}}
