<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}} - Pong User Management</title>
  <link rel="stylesheet" href="/public/css/styles.css">
</head>
<body>
  <div class="container">
    <header class="header">
      <div class="logo">
        <h1>Pong</h1>
      </div>
      <nav class="navigation">
        <ul class="nav-list">
          {{#if session.user}}
            <li><a href="/">Home</a></li>
            <li><a href="/users/profile">My Profile</a></li>
            <li><a href="/users/matches">Match History</a></li>
            <li><a href="/friends">Friends</a></li>
            <li><a href="/friends/requests">Friend Requests</a></li>
            <li><a href="/users">Users</a></li>
            <li><a href="/auth/logout">Logout</a></li>
          {{else}}
            <li><a href="/auth/login">Login</a></li>
            <li><a href="/auth/register">Register</a></li>
          {{/if}}
        </ul>
      </nav>
    </header>
    
    <main class="content">
      {{{body}}}
    </main>
    
    <footer class="footer">
      <p>&copy; 2025 Pong User Management</p>
    </footer>
  </div>
</body>
</html>
