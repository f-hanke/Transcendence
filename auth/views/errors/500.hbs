<div style="text-align: center; padding: 50px 0;">
  <h1 style="font-size: 6rem; margin: 0; color: #e74c3c;">500</h1>
  <h2 style="margin: 10px 0 30px;">Server Error</h2>
  <p>Something went wrong on our end. Please try again later.</p>
  {{#if error}}
    <div style="background-color: #f8d7da; color: #721c24; padding: 15px; border-radius: 5px; margin: 20px auto; max-width: 500px; text-align: left;">
      <strong>Error:</strong> {{error}}
    </div>
  {{/if}}
  <a href="/" class="form-button" style="margin-top: 30px; display: inline-block;">Go Home</a>
</div>
