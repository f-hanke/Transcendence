{
  "compilerOptions": {
    "target": "ESNext",                              /* Utiliser ES6 pour le code généré */
    "module": "ESNext",                         /* Utiliser le format de module CommonJS */
    "moduleResolution": "bundler",
    "outDir": "./dist",                           /* Dossier de sortie pour les fichiers compilés */
    "rootDir": "./src",                           /* Dossier contenant les fichiers source TypeScript */
    "esModuleInterop": true,                      /* Pour importer des modules CommonJS avec la syntaxe ES6 */
    "strict": true,                               /* Activer toutes les vérifications strictes */
    "skipLibCheck": true,                          /* Ignorer la vérification des fichiers .d.ts */
    "typeRoots": ["./node_modules/@types", "./types"]
  },
  "include": [
    "src/**/*.ts", "types.d.ts"                                 /* Inclure tous les fichiers .ts dans le dossier src */
  ],
  "exclude": [
    "node_modules", "dist"                                /* Exclure le dossier node_modules */
  ]
}

